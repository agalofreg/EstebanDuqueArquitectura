<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Duque Obra · Duque Arquitectura</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
<style>
:root{
  --ink:#0F172A; --ink2:#334155; --mute:#64748B; --soft:#94A3B8; --line:rgba(15,23,42,.08);
  --card:rgba(255,255,255,.78); --indigo:#5B5BF7; --violet:#A855F7; --pink:#EC4899;
  --ok:#059669; --okbg:#D1FAE5; --warn:#B45309; --warnbg:#FEF3C7; --risk:#B91C1C; --riskbg:#FEE2E2;
  --aurora:linear-gradient(120deg,#5B5BF7 0%,#A855F7 55%,#EC4899 100%);
}
*{box-sizing:border-box}
html,body{margin:0;height:100%}
body{font-family:'Inter',system-ui,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;
  background:radial-gradient(1200px 600px at 20% -10%,rgba(91,91,247,.35),transparent 60%),
             radial-gradient(900px 600px at 110% 20%,rgba(168,85,247,.28),transparent 60%),
             radial-gradient(900px 500px at 50% 120%,rgba(236,72,153,.18),transparent 60%),#0B1020;
  overflow:hidden}
button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
input,select{font-family:inherit}

/* ---------- stage ---------- */
.protobar{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 28px;color:#E2E8F0}
.protobar .brand{display:flex;align-items:center;gap:12px;font-weight:600;font-size:14px}
.protobar .brand small{color:#94A3B8;font-weight:500}
.seg-dark{display:flex;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:4px}
.seg-dark button{padding:7px 16px;border-radius:999px;font-size:13px;font-weight:600;color:#CBD5E1;display:flex;align-items:center;gap:7px}
.seg-dark button.on{background:#fff;color:var(--ink)}
.protobar .note{font-size:12px;color:#94A3B8}
.stagebody{height:calc(100% - 64px);display:flex;align-items:flex-start;justify-content:center}
.fit{position:relative}
.fit > .dev{position:absolute;top:0;left:0;transform-origin:top left}

/* ---------- tablet ---------- */
.tablet{width:1320px;height:880px;border-radius:46px;padding:16px;background:linear-gradient(145deg,#2A2D35,#121318);
  box-shadow:0 40px 80px rgba(0,0,0,.55),inset 0 0 0 1.5px rgba(255,255,255,.08)}
.tablet .cam{position:absolute;top:7px;left:50%;width:8px;height:8px;margin-left:-4px;border-radius:9px;background:#0a0a0c;box-shadow:inset 0 0 0 1.5px #22252c}
.screen{position:fixed;inset:0;overflow:hidden;display:grid;grid-template-columns:264px 1fr;
  background:radial-gradient(900px 520px at 88% -8%,rgba(165,180,252,.55),transparent 60%),
             radial-gradient(700px 520px at 112% 62%,rgba(216,180,254,.42),transparent 60%),
             radial-gradient(600px 420px at 30% 112%,rgba(167,243,208,.45),transparent 60%),#F4F6FA}
.statusbar{position:absolute;top:0;left:0;right:0;height:30px;display:flex;align-items:center;justify-content:space-between;padding:0 26px;font-size:12.5px;font-weight:600;z-index:20;pointer-events:none}
.statusbar span.d{font-weight:500;color:var(--ink2);margin-left:8px}

/* sidebar */
.side{padding:26px 14px 16px;background:rgba(255,255,255,.55);backdrop-filter:blur(22px);-webkit-backdrop-filter:blur(22px);border-right:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
.logo{display:flex;align-items:center;gap:10px;padding:0 10px 22px}
.logo b{font-size:17px;letter-spacing:-.02em}
.logo i{font-style:normal;font-size:12px;font-weight:600;padding:2px 8px;border-radius:999px;background:var(--aurora);color:#fff;margin-left:2px}
.navlabel{font-size:11px;font-weight:600;color:var(--soft);padding:16px 12px 6px}
.nav{display:flex;align-items:center;gap:11px;width:100%;padding:9px 12px;border-radius:12px;font-size:14px;font-weight:500;color:var(--ink2);text-align:left}
.nav:hover{background:rgba(255,255,255,.7)}
.nav.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 2px rgba(15,23,42,.06),0 4px 14px rgba(15,23,42,.05)}
.nav .dot{width:8px;height:8px;border-radius:9px;flex-shrink:0;margin:0 5px 0 3px}
.nav .count{margin-left:auto;font-size:11px;font-weight:600;color:var(--mute);background:rgba(15,23,42,.05);padding:2px 7px;border-radius:9px}
.me{margin-top:auto;display:flex;align-items:center;gap:11px;padding:12px 10px 4px;border-top:1px solid var(--line)}
.avatar{width:38px;height:38px;border-radius:99px;background:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;box-shadow:0 1px 3px rgba(15,23,42,.1);flex-shrink:0}
.me b{font-size:13.5px;display:block}.me small{font-size:12px;color:var(--mute)}
.poweredby{font-size:10.5px;color:var(--soft);padding:10px 10px 0}

/* main */
.main{position:relative;overflow:hidden;min-height:0}
.scroll{height:100%;overflow-y:auto;padding:34px 48px 120px}
.wrapc{max-width:1240px;margin:0 auto}
.scroll::-webkit-scrollbar{width:8px}.scroll::-webkit-scrollbar-thumb{background:rgba(15,23,42,.12);border-radius:9px}
.topline{display:flex;align-items:center;gap:14px;margin-bottom:6px}
.back{width:40px;height:40px;border-radius:99px;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(15,23,42,.08);color:#DC2626}
h1{font-size:34px;letter-spacing:-.03em;margin:6px 0 4px;font-weight:700}
.sub{color:var(--mute);font-size:15px}
.card{background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:0 1px 2px rgba(15,23,42,.03),0 10px 30px rgba(15,23,42,.04)}
.ai{border:1.5px solid transparent;background:linear-gradient(rgba(255,255,255,.92),rgba(255,255,255,.92)) padding-box,var(--aurora) border-box}
.eyebrow{font-size:12px;font-weight:600;color:var(--mute);letter-spacing:.01em}
.ai-eyebrow{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:700;background:var(--aurora);-webkit-background-clip:text;background-clip:text;color:transparent}
.pill{display:inline-flex;align-items:center;gap:6px;padding:5px 11px;border-radius:999px;font-size:12px;font-weight:600;white-space:nowrap}
.pill .d{width:7px;height:7px;border-radius:9px}
.src{display:inline-flex;align-items:center;gap:5px;padding:2px 9px 2px 7px;margin:0 2px;border-radius:999px;font-size:11.5px;font-weight:600;background:#EEF0FF;color:#4338CA;vertical-align:1px;border:1px solid #DDE0FF;cursor:pointer;white-space:nowrap}
.src:hover{background:#E0E4FF}
.seg{display:inline-flex;background:rgba(255,255,255,.6);border:1px solid var(--line);border-radius:999px;padding:4px;gap:2px}
.seg button{padding:9px 18px;border-radius:999px;font-size:14px;font-weight:500;color:var(--ink2)}
.seg button.on{background:#fff;color:var(--ink);font-weight:600;box-shadow:0 1px 3px rgba(15,23,42,.1)}
.chip{padding:8px 15px;border-radius:999px;font-size:13.5px;font-weight:500;background:rgba(255,255,255,.75);border:1px solid var(--line);color:var(--ink2)}
.chip.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.btn{white-space:nowrap;display:inline-flex;align-items:center;gap:8px;padding:11px 18px;border-radius:999px;font-size:14px;font-weight:600}
.btn.pri{background:var(--ink);color:#fff}
.btn.pri:hover{background:#1E293B}
.btn.sec{background:#fff;border:1px solid var(--line);color:var(--ink)}
.btn.grad{background:var(--aurora);color:#fff}
.iconbtn{width:40px;height:40px;border-radius:99px;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(15,23,42,.08);color:var(--ink2)}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.kpi{padding:18px 20px}
.kpi .v{font-size:30px;font-weight:700;letter-spacing:-.03em;margin-top:6px}
.kpi .t{font-size:12.5px;color:var(--mute);margin-top:2px}
.pgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.pcard{overflow:hidden;cursor:pointer;transition:transform .15s,box-shadow .15s}
.pcard:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(15,23,42,.09)}
.pcard .img{height:128px;position:relative}
.pcard .img .pill{position:absolute;top:12px;right:12px;background:rgba(255,255,255,.92)}
.bar{height:6px;border-radius:9px;background:rgba(15,23,42,.07);position:relative;overflow:hidden}
.bar i{position:absolute;left:0;top:0;bottom:0;border-radius:9px}
.bar b{position:absolute;top:-3px;bottom:-3px;width:2px;background:var(--ink);border-radius:2px}
.brief li{list-style:none;display:flex;gap:12px;padding:13px 0;border-top:1px solid var(--line);font-size:14.5px;line-height:1.55}
.brief li:first-child{border-top:0}
.brief .ico{width:28px;height:28px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}
.linkp{margin-left:auto;align-self:center;font-size:13px;font-weight:600;color:var(--indigo);white-space:nowrap;display:flex;align-items:center;gap:4px}
table{width:100%;border-collapse:collapse}
th{font-size:11.5px;font-weight:600;color:var(--mute);text-align:left;padding:12px 16px;border-bottom:1px solid var(--line)}
td{font-size:14px;padding:14px 16px;border-bottom:1px solid var(--line)}
tr:last-child td{border-bottom:0}
td:first-child,td.num,th.num{white-space:nowrap}
.num{text-align:right;font-variant-numeric:tabular-nums}
.ring{position:relative;width:132px;height:132px}
.ring .c{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.ring .c b{font-size:28px;letter-spacing:-.03em}
.ring .c small{font-size:11.5px;color:var(--mute)}
.gantt .row{display:grid;grid-template-columns:170px 1fr 70px;align-items:center;gap:14px;padding:11px 0;border-top:1px solid var(--line)}
.gantt .track{position:relative;height:26px}
.gantt .plan{position:absolute;top:3px;height:20px;border-radius:7px;background:rgba(15,23,42,.06);border:1px dashed rgba(15,23,42,.18)}
.gantt .real{position:absolute;top:7px;height:12px;border-radius:6px}
.gantt .today{position:absolute;top:-8px;bottom:-8px;width:2px;background:#DC2626;border-radius:2px}
.commit{display:flex;gap:12px;padding:14px 0;border-top:1px solid var(--line)}
.commit:first-child{border-top:0}
.tag{font-size:11px;font-weight:600;padding:3px 8px;border-radius:7px;white-space:nowrap}
.photos{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.photo{border-radius:16px;overflow:hidden;cursor:pointer;position:relative;aspect-ratio:4/3}
.photo .cap{position:absolute;left:0;right:0;bottom:0;padding:22px 12px 10px;background:linear-gradient(transparent,rgba(15,23,42,.72));color:#fff;font-size:12px;font-weight:600}
.photo .cap small{display:block;font-weight:500;opacity:.8}

/* ask bar */
.askbar{position:absolute;left:50%;bottom:22px;transform:translateX(-50%);width:min(640px,86%);display:flex;align-items:center;gap:12px;padding:10px 12px 10px 12px;border-radius:999px;background:rgba(255,255,255,.9);backdrop-filter:blur(16px);border:1px solid var(--line);box-shadow:0 10px 30px rgba(15,23,42,.12);cursor:pointer;z-index:15}
.askbar .orb{width:34px;height:34px;border-radius:99px;background:var(--aurora);display:flex;align-items:center;justify-content:center;color:#fff;box-shadow:0 4px 14px rgba(168,85,247,.45)}
.askbar .lbl{font-size:15px;font-weight:500;color:var(--ink2);flex:1}
.fase{font-size:11.5px;font-weight:600;color:var(--mute);background:rgba(15,23,42,.05);padding:5px 11px;border-radius:999px}

/* panels */
.scrim{position:absolute;inset:0;background:rgba(15,23,42,.28);opacity:0;pointer-events:none;transition:opacity .2s;z-index:30}
.scrim.on{opacity:1;pointer-events:auto}
.drawer{position:absolute;top:12px;right:12px;bottom:12px;width:520px;background:#fff;border-radius:24px;box-shadow:0 30px 60px rgba(15,23,42,.25);transform:translateX(560px);transition:transform .28s cubic-bezier(.2,.8,.2,1);z-index:31;display:flex;flex-direction:column;overflow:hidden}
.drawer.on{transform:none}
.drawer .hd{padding:22px 24px 14px;border-bottom:1px solid var(--line);display:flex;align-items:flex-start;gap:12px}
.drawer .bd{flex:1;overflow-y:auto;padding:20px 24px 28px}
.doc{font-size:13.5px;line-height:1.7;color:var(--ink2);background:#FAFAF9;border:1px solid var(--line);border-radius:14px;padding:18px 20px}
.doc mark{background:linear-gradient(transparent 55%,rgba(168,85,247,.28) 55%);color:var(--ink);padding:0 1px}
.modal{position:absolute;left:50%;top:50%;width:620px;max-height:84%;transform:translate(-50%,-46%) scale(.97);opacity:0;pointer-events:none;background:#fff;border-radius:26px;box-shadow:0 30px 70px rgba(15,23,42,.3);z-index:32;transition:all .22s;display:flex;flex-direction:column;overflow:hidden}
.modal.on{opacity:1;pointer-events:auto;transform:translate(-50%,-50%)}
.modal .hd{padding:24px 28px 8px;display:flex;align-items:flex-start;gap:14px}
.modal .bd{padding:10px 28px 26px;overflow-y:auto}
.field{margin-bottom:14px}
.field label{display:block;font-size:12.5px;font-weight:600;color:var(--ink2);margin-bottom:6px}
.field input,.field select{width:100%;padding:12px 14px;border-radius:12px;border:1px solid rgba(15,23,42,.14);font-size:14.5px;background:#F8FAFC;color:var(--ink);outline:none}
.field input:focus,.field select:focus{border-color:var(--indigo);background:#fff;box-shadow:0 0 0 4px rgba(91,91,247,.12)}
.drop{border:1.5px dashed rgba(15,23,42,.2);border-radius:14px;padding:18px;display:flex;align-items:center;gap:12px;font-size:13.5px;color:var(--mute);cursor:pointer;background:#F8FAFC}
.drop.ok{border-style:solid;border-color:#A7F3D0;background:#ECFDF5;color:var(--ok)}
.steps .st{display:flex;align-items:center;gap:12px;padding:11px 0;font-size:14px;color:var(--soft);transition:color .2s}
.steps .st .b{width:26px;height:26px;border-radius:99px;border:1.5px solid rgba(15,23,42,.15);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.steps .st.done{color:var(--ink)}
.steps .st.done .b{background:var(--ok);border-color:var(--ok);color:#fff}
.steps .st.run .b{border-color:var(--indigo);border-top-color:transparent;animation:spin .7s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.toast{position:absolute;left:50%;top:44px;transform:translate(-50%,-20px);opacity:0;background:var(--ink);color:#fff;padding:11px 18px;border-radius:999px;font-size:13.5px;font-weight:600;display:flex;align-items:center;gap:8px;z-index:40;transition:all .25s;pointer-events:none}
.toast.on{opacity:1;transform:translate(-50%,0)}
.chat .q{align-self:flex-end;background:var(--ink);color:#fff;padding:11px 15px;border-radius:18px 18px 4px 18px;font-size:14px;max-width:85%}
.chat .a{align-self:flex-start;background:#F5F3FF;border:1px solid #EDE9FE;padding:14px 16px;border-radius:18px 18px 18px 4px;font-size:14px;line-height:1.6;max-width:92%}
.typing i{display:inline-block;width:7px;height:7px;border-radius:9px;background:#A78BFA;margin-right:4px;animation:blink 1s infinite}
.typing i:nth-child(2){animation-delay:.15s}.typing i:nth-child(3){animation-delay:.3s}
@keyframes blink{0%,100%{opacity:.25}50%{opacity:1}}
.sugg{display:flex;flex-wrap:wrap;gap:8px}
.sugg button{font-size:13px;font-weight:500;padding:8px 13px;border-radius:999px;background:#F8FAFC;border:1px solid var(--line);color:var(--ink2);text-align:left}
.sugg button:hover{border-color:#C4B5FD;background:#F5F3FF}
.fade{animation:fade .25s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* ---------- phone ---------- */
.phone{width:410px;height:860px;border-radius:64px;padding:13px;background:linear-gradient(145deg,#2A2D35,#121318);box-shadow:0 40px 80px rgba(0,0,0,.55),inset 0 0 0 1.5px rgba(255,255,255,.08)}
.pscreen{position:relative;width:100%;height:100%;border-radius:52px;overflow:hidden;
  background:radial-gradient(420px 320px at 90% -5%,rgba(165,180,252,.6),transparent 60%),radial-gradient(360px 300px at -10% 55%,rgba(216,180,254,.45),transparent 60%),radial-gradient(380px 300px at 60% 110%,rgba(167,243,208,.5),transparent 60%),#F4F6FA}
.island{position:absolute;top:11px;left:50%;width:122px;height:35px;margin-left:-61px;border-radius:20px;background:#050506;z-index:30}
.pstatus{position:absolute;top:0;left:0;right:0;height:54px;display:flex;align-items:center;justify-content:space-between;padding:6px 32px 0 36px;font-size:15px;font-weight:600;z-index:25}
.pbody{position:absolute;top:54px;left:0;right:0;bottom:84px;overflow-y:auto;padding:8px 18px 24px}
.pbody::-webkit-scrollbar{display:none}
.ptabs{position:absolute;left:14px;right:14px;bottom:22px;height:62px;border-radius:24px;background:rgba(255,255,255,.88);backdrop-filter:blur(16px);border:1px solid var(--line);box-shadow:0 10px 30px rgba(15,23,42,.1);display:grid;grid-template-columns:repeat(4,1fr);z-index:20}
.ptabs button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-size:10.5px;font-weight:600;color:var(--soft)}
.ptabs button.on{color:var(--ink)}
.homeind{position:absolute;bottom:8px;left:50%;width:134px;height:5px;margin-left:-67px;border-radius:9px;background:var(--ink);opacity:.85;z-index:21}
.pcardm{background:rgba(255,255,255,.85);border:1px solid var(--line);border-radius:22px;padding:16px 18px;margin-bottom:12px}
</style>
</head>
