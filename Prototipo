 '¿Qué proyectos están sobre presupuesto?':`Solo <b>Edificio Cedro 84</b>: la proyección de cierre está 12% por encima del contrato por la orden de cambio #3 en la fachada ${srcChip('Pagos','tab:pagos','cedro')}. Los otros cinco proyectos visibles cierran dentro del valor pactado.`,
 '¿Cuándo se acordó la acometida en Los Alcaparros?':`Se acordó en el <b>comité #11 del 1 de septiembre</b> ${srcChip('Acta #11','acta:11','alcaparros')}, a cargo del contratista eléctrico. Volvió a aparecer como pendiente en el comité #12 del 15 de septiembre ${srcChip('Acta #12','acta:12','alcaparros')}. Lleva 23 días abierto.`,
 '¿Qué clientes tienen pagos próximos?':`En los próximos 10 días: <b>Oficinas Norte</b> $48 M el 30 sep ${srcChip('Pagos','tab:pagos','norte')} y <b>Edificio Cedro 84</b> $310 M el 2 oct ${srcChip('Pagos','tab:pagos','cedro')}.`
};
function openAsk(){
 openDrawer(`<div class="hd"><div class="orb" style="width:40px;height:40px;border-radius:99px;background:var(--aurora);display:flex;align-items:center;justify-content:center">${ic('spark',19,'#fff')}</div><div style="flex:1"><div style="font-weight:700;font-size:18px">Pregúntale a tus proyectos</div><div style="font-size:12.5px;color:var(--mute);margin-top:2px">Responde solo con actas, pagos y cronogramas de Duque · <span class="fase" style="padding:2px 8px">Fase 2</span></div></div><button class="iconbtn" data-close>${ic('x',18)}</button></div>
  <div class="bd"><div class="chat" id="chat" style="display:flex;flex-direction:column;gap:12px"></div>
   <div style="margin-top:18px"><div class="eyebrow" style="margin-bottom:10px">Prueba con</div><div class="sugg">${Object.keys(QA).map(q=>`<button data-q="${q}">${q}</button>`).join('')}</div></div>
   <div style="font-size:11.5px;color:var(--soft);margin-top:18px">Respuestas de ejemplo en este prototipo. Cada afirmación cita su documento de origen.</div>
  </div>`);
}
function ask(q){
 const c=document.getElementById('chat');if(!c)return;
 c.insertAdjacentHTML('beforeend',`<div class="q fade">${q}</div><div class="a typing fade" id="typing"><i></i><i></i><i></i></div>`);
 setTimeout(()=>{const t=document.getElementById('typing');if(t){t.outerHTML=`<div class="a fade">${QA[q]}</div>`}},900);
}

/* ======================= CLIENT PREVIEW ======================= */
function clientPreview(pid){
 const p=byId(pid); const ph=phasesFor(p); const paid=payFor(p).filter(r=>r.dir==='in').reduce((x,r)=>x+r.m,0);
 openDrawer(`<div class="hd"><div style="width:42px;height:42px;border-radius:12px;background:#EEF0FF;color:#4338CA;display:flex;align-items:center;justify-content:center">${ic('eye',20)}</div><div style="flex:1"><div style="font-weight:700;font-size:18px">Así lo ve el cliente</div><div style="font-size:12.5px;color:var(--mute);margin-top:2px">${p.client} · acceso solo a ${p.name}</div></div><button class="iconbtn" data-close>${ic('x',18)}</button></div>
 <div class="bd">
  <div class="card" style="overflow:hidden;padding:0"><div style="height:150px;position:relative">${bld(p,480,150)}<span class="pill" style="position:absolute;top:12px;left:12px;background:rgba(255,255,255,.94);color:${ST[p.status].fg}"><span class="d" style="background:${ST[p.status].d}"></span>${ST[p.status].l}</span></div>
   <div style="padding:16px 18px"><div style="font-weight:700;font-size:18px">${p.name}</div><div style="font-size:15px;line-height:1.55;margin-top:6px;color:#1E293B">${p.clientTxt}</div><div style="font-size:11.5px;color:var(--mute);margin-top:10px">Aprobado por Esteban antes de publicarse</div></div></div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px">
   <div class="card" style="padding:16px;display:flex;align-items:center;gap:12px"><div class="ring" style="width:72px;height:72px">${ringSVG(p.progress,'#5B5BF7',72,8)}<div class="c"><b style="font-size:17px">${p.progress}%</b></div></div><div><div class="eyebrow">Avance</div><div style="font-weight:700;margin-top:3px">${p.stage}</div></div></div>
   <div class="card" style="padding:16px"><div class="eyebrow">Has pagado</div><div style="font-weight:700;font-size:20px;margin-top:4px">${fmt(paid)}</div><div class="bar" style="margin-top:8px"><i style="width:${paid/p.budget*100}%;background:#10B981"></i></div><div style="font-size:11.5px;color:var(--mute);margin-top:6px">de ${fmt(p.budget)}</div></div>
  </div>
  <div class="card" style="padding:14px 18px;margin-top:12px">${ph.map((f,i)=>`<div style="display:flex;gap:10px;align-items:center;padding:8px 0;${i?'border-top:1px solid var(--line)':''}">${f.done?ic('check',16,'#5B5BF7',2.6):f.re!=null?`<svg width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="#5B5BF7" stroke-width="2.4"/><circle cx="12" cy="12" r="3.5" fill="#5B5BF7"/></svg>`:`<svg width="16" height="16" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" fill="none" stroke="#CBD5E1" stroke-width="2"/></svg>`}<span style="font-size:14px;${!f.done&&f.re==null?'color:var(--soft)':'font-weight:500'}">${f.n}</span><span style="margin-left:auto;font-size:12px;color:var(--mute)">${f.done?'Completado':f.re!=null?'En curso':'Pendiente'}</span></div>`).join('')}</div>
  <div class="card" style="padding:14px 18px;margin-top:12px;display:flex;align-items:center;gap:12px"><div style="width:38px;height:38px;border-radius:12px;background:#ECFDF5;color:#059669;display:flex;align-items:center;justify-content:center">${ic('wallet',18)}</div><div style="flex:1"><div class="eyebrow">Próximo pago</div><div style="font-weight:700;margin-top:2px">${fmt(p.next.m)} · ${p.next.t}</div></div><div style="font-size:13px;color:var(--mute)">${p.next.d}</div></div>
 </div>`);
}

/* ======================= RENDER / ROUTER ======================= */
P.forEach(p=>{p.cnote=p.client; });
P.forEach(p=>{const m={alcaparros:0,cedro:1,norte:2,mirador:3,bosque:4,taller:5};});
// client narratives
const CN={alcaparros:'Tu casa avanza en la etapa de obra gris. Estamos cerrando la instalación eléctrica provisional y esperamos recuperar el ritmo en las próximas dos semanas.',cedro:'La estructura avanza en el piso 4 de 8. Tenemos una actualización de costos por un cambio en la fachada que revisaremos contigo esta semana.',norte:'Tu proyecto avanza según lo planeado. La estructura está completa y los acabados van en progreso.',mirador:'Estamos en la recta final de acabados. La carpintería de habitaciones llegará unos días más tarde de lo previsto.',bosque:'La cimentación de tu casa avanza bien y un poco por delante de lo planeado.',taller:'Tu proyecto arrancó en la fecha prevista. Estamos en obras preliminares.'};
P.forEach(p=>{p.clientTxt=CN[p.id];p.clientNoteShort=CN[p.id]});

function render(){
 const dev=document.getElementById('dev');
 if(!document.querySelector('.screen')) dev.innerHTML=ownerShell();
 renderSide();
 document.getElementById('view').innerHTML='<div class="wrapc">'+(S.view==='home'?vHome(): S.view==='project'?vProject(): S.view==='proyectos'?vProyectos(): S.view==='clientes'?vClientes(): vPagos())+'</div>';
 const h= S.view==='project'?`#/proyecto/${S.pid}/${S.tab}`:`#/${S.view}`;
 if(location.hash!==h) history.replaceState(null,'',h);
}
function go(o){const scroll=document.getElementById('view');Object.assign(S,o);render();if(scroll&&('view' in o||'pid' in o))document.getElementById('view').scrollTop=0}
function parseHash(){
 const h=location.hash.replace(/^#\/?/,'').split('/');
 if(h[0]==='proyecto'&&byId(h[1])) Object.assign(S,{mode:'owner',view:'project',pid:h[1],tab:h[2]||'resumen'});

 else if(['home','proyectos','clientes','pagos'].includes(h[0])) Object.assign(S,{mode:'owner',view:h[0]});
}

document.addEventListener('click',e=>{
 const t=e.target.closest('[data-mode],[data-go],[data-pid],[data-tab],[data-filter],[data-acta],[data-ref],[data-photo],[data-close],[data-newpay],[data-client],[data-toast],[data-q],[data-ctab],#askbar,#scrim,#newClient,#ncGo,#fpSave,#fpDrop');
 if(!t)return;
 if(t.id==='scrim'||t.hasAttribute('data-close')){closeAll();return}
 if(t.dataset.client){clientPreview(t.dataset.client);return}
 if(t.dataset.ref){const [k,v]=t.dataset.ref.split(':');const pid=t.dataset.pid;
   if(k==='acta'){showActa(pid,v);return}
   if(k==='tab'){closeAll();go({view:'project',pid,tab:v,acta:0});return}}
 if(t.dataset.q){ask(t.dataset.q);return}
 if(t.id==='askbar'){openAsk();return}
 if(t.id==='newClient'){newClient();return}
 if(t.id==='ncGo'){runClientSteps();return}
 if(t.id==='fpDrop'){t.classList.add('ok');t.innerHTML=ic('check',20,'#059669',2.2)+'<span><b>soporte_transferencia.jpg</b> adjunto · 312 KB</span>';return}
 if(t.id==='fpSave'){const pid=document.getElementById('fpP').value;const dir=document.getElementById('fpD').value;
   (EXTRA_PAY[pid]=EXTRA_PAY[pid]||[]).unshift({d:'24 sep',c:document.getElementById('fpC').value,pv:dir==='in'?byId(pid).client:'Proveedor',m:parseInt(document.getElementById('fpM').value)||0,dir,ok:1,fresh:1});
   closeAll();go({view:'project',pid,tab:'pagos'});toast('Pago registrado y validado');setTimeout(()=>{(EXTRA_PAY[pid]||[]).forEach(r=>r.fresh=0)},100);return}
 if(t.dataset.newpay){newPay(t.dataset.newpay);return}
 if(t.dataset.toast){toast(t.dataset.toast);return}
 if(t.dataset.photo){showPhoto(+t.dataset.photo);return}
 if(t.dataset.acta){S.acta=+t.dataset.acta;go({});return}
 if(t.dataset.filter){go({filter:t.dataset.filter});return}
 if(t.dataset.tab){go({tab:t.dataset.tab,acta:0});return}
 if(t.dataset.pid){closeAll();go({view:'project',pid:t.dataset.pid,tab:'resumen',acta:0});return}
 if(t.dataset.go){go({view:t.dataset.go});return}
});
addEventListener('hashchange',()=>{parseHash();render()});
parseHash();render();
</script>
