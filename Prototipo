function bld(p,W,H,prog){
 prog=prog==null?p.progress:prog; const id='g'+(gid++); const hue=p.hue;
 const gy=H*.8, s=Math.min(W/300,H/170);
 let out=`<svg viewBox="0 0 ${W} ${H}" width="100%" height="100%" preserveAspectRatio="xMidYMid slice"><defs>
 <linearGradient id="${id}s" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="hsl(${hue},75%,86%)"/><stop offset="1" stop-color="hsl(${hue+25},60%,96%)"/></linearGradient>
 <linearGradient id="${id}w" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#F8FAFC"/><stop offset="1" stop-color="#E2E8F0"/></linearGradient>
 <linearGradient id="${id}g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="hsl(${hue},45%,34%)"/><stop offset="1" stop-color="hsl(${hue},55%,20%)"/></linearGradient>
 <linearGradient id="${id}c" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#CBD5E1"/><stop offset="1" stop-color="#94A3B8"/></linearGradient></defs>
 <rect width="${W}" height="${H}" fill="url(#${id}s)"/>
 <circle cx="${W*.82}" cy="${H*.24}" r="${22*s}" fill="#fff" opacity=".55"/>
 <path d="M0 ${gy-18*s} Q ${W*.25} ${gy-40*s} ${W*.5} ${gy-22*s} T ${W} ${gy-26*s} V ${gy} H0Z" fill="hsl(${hue+40},25%,82%)" opacity=".7"/>
 <rect y="${gy}" width="${W}" height="${H-gy}" fill="hsl(40,20%,86%)"/>`;
 const scaf=(x,y,w,h)=>`<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="none" stroke="#94A3B8" stroke-width="${1.2*s}" stroke-dasharray="${4*s} ${3*s}" opacity=".85"/>`;
 const box=(x,y,w,h,glass)=>`<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#${id}w)" stroke="#CBD5E1" stroke-width="${.8*s}"/>`+(glass?`<rect x="${x+w*.1}" y="${y+h*.2}" width="${w*.8}" height="${h*.55}" fill="url(#${id}g)" opacity=".9"/><path d="M${x+w*.1} ${y+h*.2} L${x+w*.35} ${y+h*.2} L${x+w*.1} ${y+h*.6}Z" fill="#fff" opacity=".16"/>`:'');
 let top=gy, cx=W*.5;
 if(p.kind==='torre'){
  const bw=86*s, bx=cx-bw/2, n=8, fh=15*s; const built=Math.round(n*prog/100);
  for(let i=0;i<n;i++){const y=gy-(i+1)*fh; if(i<built){out+=`<rect x="${bx}" y="${y}" width="${bw}" height="${fh}" fill="url(#${id}w)" stroke="#CBD5E1" stroke-width="${.7*s}"/><rect x="${bx+5*s}" y="${y+4*s}" width="${bw-10*s}" height="${fh-8*s}" fill="url(#${id}g)" opacity=".85"/>`} else out+=scaf(bx,y,bw,fh)}
  top=gy-n*fh;
 } else if(p.kind==='oficina'||p.kind==='oficina2'){
  const bw=190*s, bx=cx-bw/2, n=3, fh=24*s; const built=Math.max(1,Math.round(n*prog/100)) - (prog<20?1:0);
  for(let i=0;i<n;i++){const y=gy-(i+1)*fh, off=(i===2?18*s:0); if(i<built){out+=`<rect x="${bx+off}" y="${y}" width="${bw-off*2}" height="${fh}" fill="url(#${id}w)" stroke="#CBD5E1" stroke-width="${.7*s}"/><rect x="${bx+off+6*s}" y="${y+6*s}" width="${bw-off*2-12*s}" height="${fh-11*s}" fill="url(#${id}g)" opacity=".85"/>`;for(let k=1;k<8;k++)out+=`<line x1="${bx+off+k*(bw-off*2)/8}" y1="${y+6*s}" x2="${bx+off+k*(bw-off*2)/8}" y2="${y+fh-5*s}" stroke="#fff" stroke-opacity=".35" stroke-width="${.8*s}"/>`} else out+=scaf(bx+off,y,bw-off*2,fh)}
  top=gy-n*fh;
 } else if(p.kind==='hotel'){
  const steps=[[220,22],[170,22],[120,22]]; let y=gy;
  steps.forEach(([w,h],i)=>{w*=s;h*=s;y-=h;const x=cx-w/2+i*14*s; if(prog>=(i+1)*28) out+=box(x,y,w,h,true)+`<rect x="${x}" y="${y-2*s}" width="${w}" height="${3*s}" fill="hsl(${hue},30%,40%)" opacity=".5"/>`; else out+=scaf(x,y,w,h)});
  top=y;
 } else {
  const w1=150*s,h1=36*s,x1=cx-w1/2-20*s, w2=120*s,h2=30*s,x2=cx-w2/2+35*s;
  if(prog>=15) out+=box(x1,gy-h1,w1,h1,true); else out+=scaf(x1,gy-h1,w1,h1);
  if(prog>=55) out+=box(x2,gy-h1-h2,w2,h2,true)+`<rect x="${x2-6*s}" y="${gy-h1-h2-3*s}" width="${w2+12*s}" height="${3.5*s}" fill="hsl(${hue},25%,35%)" opacity=".7"/>`; else out+=scaf(x2,gy-h1-h2,w2,h2);
  top=gy-h1-h2;
 }
 if(prog<85){const cxr=cx+(p.kind==='torre'?78:125)*s, ct=Math.min(top-26*s,gy-100*s);
  out+=`<line x1="${cxr}" y1="${gy}" x2="${cxr}" y2="${ct}" stroke="#F59E0B" stroke-width="${2.4*s}"/><line x1="${cxr-70*s}" y1="${ct+4*s}" x2="${cxr+28*s}" y2="${ct+4*s}" stroke="#F59E0B" stroke-width="${2.2*s}"/><line x1="${cxr-52*s}" y1="${ct+4*s}" x2="${cxr-52*s}" y2="${ct+30*s}" stroke="#475569" stroke-width="${.9*s}"/><rect x="${cxr-56*s}" y="${ct+30*s}" width="${8*s}" height="${6*s}" fill="#475569"/>`}
 [[.1,1],[.9,1.2],[.18,.8]].forEach(([fx,k])=>{const tx=W*fx,r=13*s*k;out+=`<rect x="${tx-1.2*s}" y="${gy-r}" width="${2.4*s}" height="${r}" fill="#6B7280" opacity=".6"/><circle cx="${tx}" cy="${gy-r-r*.5}" r="${r*.9}" fill="hsl(${140+hue%30},35%,${48+k*6}%)" opacity=".9"/>`});
 return out+'</svg>';
}

