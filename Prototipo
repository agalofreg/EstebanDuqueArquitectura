function openDrawer(html){const d=document.getElementById('drawer');d.innerHTML=html;d.classList.add('on');document.getElementById('scrim').classList.add('on')}
function openModal(html){const m=document.getElementById('modal');m.innerHTML=html;m.classList.add('on');document.getElementById('scrim').classList.add('on')}
function closeAll(){['drawer','modal'].forEach(i=>document.getElementById(i)?.classList.remove('on'));document.getElementById('scrim')?.classList.remove('on')}
function toast(t){const e=document.getElementById('toast');e.innerHTML=ic('check',15,'#34D399',2.4)+t;e.classList.add('on');clearTimeout(e._t);e._t=setTimeout(()=>e.classList.remove('on'),2200)}

function showActa(pid,n){
 const p=byId(pid); const a=actasFor(p).find(x=>x.n==n)||actasFor(p)[0];
 openDrawer(`<div class="hd"><div style="width:42px;height:42px;border-radius:12px;background:#EEF0FF;color:#4338CA;display:flex;align-items:center;justify-content:center">${ic('file',20)}</div><div style="flex:1"><div style="font-weight:700;font-size:18px">${a.title}</div><div style="font-size:12.5px;color:var(--mute);margin-top:2px">${p.name} · ${a.date}</div></div><button class="iconbtn" data-close>${ic('x',18)}</button></div>
  <div class="bd">
   <div style="font-size:12px;color:var(--mute);display:flex;align-items:center;gap:7px;margin-bottom:12px">${ic('folder',14)}Dropbox / Duque / Clientes / ${p.name} / Actas / Acta comite ${a.n}.pdf</div>
   <div class="doc"><div style="font-weight:700;color:var(--ink);margin-bottom:8px">ACTA DE COMITÉ DE OBRA No. ${a.n}</div><div style="font-size:12.5px;margin-bottom:10px">Asistentes: ${a.people}</div>${a.text}</div>
   <div class="ai-eyebrow" style="margin-top:22px">${ic('spark',14,'#A855F7')}Lo que el sistema extrajo de este documento</div>
   <div style="margin-top:4px">${a.items.map(commitRow).join('')}</div>
   <div style="margin-top:16px;padding:14px 16px;border-radius:14px;background:#F8FAFC;font-size:12.5px;color:var(--mute);line-height:1.55">Cada línea resaltada en el acta corresponde a un compromiso registrado. Si una extracción tiene baja confianza, pasa a revisión humana antes de publicarse.</div>
  </div>`);
}
function showPhoto(i){
 const p=byId(S.pid);const pr=Math.max(3,Math.round(p.progress*(i+1)/WEEKS.length));
 openDrawer(`<div class="hd"><div style="flex:1"><div style="font-weight:700;font-size:18px">${CAPS[i]}</div><div style="font-size:12.5px;color:var(--mute);margin-top:2px">${p.name} · ${WEEKS[i]}</div></div><button class="iconbtn" data-close>${ic('x',18)}</button></div>
  <div class="bd"><div style="border-radius:18px;overflow:hidden;aspect-ratio:4/3">${bld(p,480,360,pr)}</div>
  <div style="display:flex;gap:10px;margin-top:16px;font-size:13px;color:var(--mute)"><span class="tag" style="background:#EEF0FF;color:#4338CA">Avance registrado ${pr}%</span><span class="tag" style="background:#F1F5F9;color:#64748B">Subida por residente de obra</span></div>
  <div style="font-size:13px;color:var(--mute);margin-top:14px;line-height:1.6">La foto llegó a la carpeta Fotos del proyecto en Dropbox y el sistema la ubicó en la línea de tiempo por su fecha, sin que nadie la renombrara.</div></div>`);
}
function newPay(pid){
 openModal(`<div class="hd"><div style="width:44px;height:44px;border-radius:13px;background:#ECFDF5;color:#059669;display:flex;align-items:center;justify-content:center">${ic('wallet',21)}</div><div style="flex:1"><div style="font-weight:700;font-size:20px">Registrar pago</div><div style="font-size:13px;color:var(--mute);margin-top:2px">Se valida al guardar y se refleja en el portal del cliente</div></div><button class="iconbtn" data-close>${ic('x',18)}</button></div>
  <div class="bd">
   <div class="field"><label>Proyecto</label><select id="fpP">${P.map(p=>`<option value="${p.id}" ${p.id===pid?'selected':''}>${p.name}</option>`).join('')}</select></div>
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><label>Tipo</label><select id="fpD"><option value="in">Pago del cliente</option><option value="out">Pago a proveedor</option></select></div><div class="field"><label>Fecha</label><input id="fpF" value="24 sep 2026"></div></div>
   <div class="field"><label>Concepto</label><input id="fpC" value="Cuota acabados"></div>
   <div class="field"><label>Monto (millones de pesos)</label><input id="fpM" value="48"></div>
   <div class="drop" id="fpDrop">${ic('upload',20)}<span>Arrastra el soporte o haz clic para adjuntarlo</span></div>
   <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:20px"><button class="btn sec" data-close>Cancelar</button><button class="btn pri" id="fpSave">${ic('check',16,'#fff',2.4)}Guardar pago</button></div>
  </div>`);
}
function newClient(){
 openModal(`<div class="hd"><div style="width:44px;height:44px;border-radius:13px;background:#EEF0FF;color:#4338CA;display:flex;align-items:center;justify-content:center">${ic('users',21)}</div><div style="flex:1"><div style="font-weight:700;font-size:20px">Nuevo cliente</div><div style="font-size:13px;color:var(--mute);margin-top:2px">Sin apoyo técnico. Menos de un minuto.</div></div><button class="iconbtn" data-close>${ic('x',18)}</button></div>
  <div class="bd" id="ncBody">
   <div class="field"><label>Nombre del cliente</label><input id="ncN" value="Familia Herrera Mejía"></div>
   <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px"><div class="field"><label>Cédula o NIT</label><input value="1.020.456.789"></div><div class="field"><label>Presupuesto inicial</label><input value="$ 1.100 M"></div></div>
   <div class="field"><label>Nombre del proyecto</label><input id="ncP" value="Casa Guaymaral"></div>
   <div class="field"><label>Contraseña para el cliente</label><input value="Guay-7Kd29" style="font-family:ui-monospace,monospace"></div>
   <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:18px"><button class="btn sec" data-close>Cancelar</button><button class="btn pri" id="ncGo">Crear cliente y acceso</button></div>
  </div>`);
}
function runClientSteps(){
 const name=document.getElementById('ncN').value, proj=document.getElementById('ncP').value;
 const steps=[['folder','Carpeta "'+proj+'" creada en Dropbox'],['layers','6 subcarpetas: Actas, Presupuesto, Pagos, Cronograma, Seguimiento, Fotos'],['db','Registro aislado en la base de datos'],['lock','Acceso del cliente generado']];
 document.getElementById('ncBody').innerHTML=`<div class="steps">${steps.map((s,i)=>`<div class="st" id="st${i}"><div class="b"></div>${s[1]}</div>`).join('')}</div><div id="ncDone"></div>`;
 steps.forEach((s,i)=>{setTimeout(()=>{document.getElementById('st'+i)?.classList.add('run')},i*650);setTimeout(()=>{const e=document.getElementById('st'+i);if(!e)return;e.classList.remove('run');e.classList.add('done');e.querySelector('.b').innerHTML=ic('check',14,'#fff',2.6)},i*650+550)});
 setTimeout(()=>{const d=document.getElementById('ncDone');if(!d)return;d.innerHTML=`<div class="fade" style="margin-top:14px;padding:18px;border-radius:16px;background:linear-gradient(120deg,#EEF0FF,#FDF2F8)"><div style="font-weight:700;font-size:15px">${name} ya tiene acceso</div><div style="font-size:13px;color:var(--ink2);margin-top:6px;line-height:1.6">Comparte estos datos por el canal que prefieras. El cliente solo verá ${proj}.</div><div style="display:flex;gap:10px;margin-top:12px"><span class="tag" style="background:#fff;color:var(--ink);padding:8px 12px;font-size:12.5px">Usuario: 1.020.456.789</span><span class="tag" style="background:#fff;color:var(--ink);padding:8px 12px;font-size:12.5px;font-family:ui-monospace,monospace">Guay-7Kd29</span></div></div><div style="display:flex;justify-content:flex-end;margin-top:16px"><button class="btn pri" data-close>Listo</button></div>`},steps.length*650+250);
}

